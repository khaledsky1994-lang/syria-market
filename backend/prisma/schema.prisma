// Syria Market - Database Schema
// Using SQLite for easy local setup. Switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Note: SQLite doesn't support native enum types in Prisma, so Role, ListingStatus,
// and ListingCondition are plain strings below, validated in application code instead.
// Allowed values — Role: USER | ADMIN
// ListingStatus: ACTIVE | SOLD | PENDING_REVIEW | REJECTED | HIDDEN
// ListingCondition: NEW | LIKE_NEW | GOOD | FAIR | FOR_PARTS

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  avatarUrl     String?
  city          String?
  role          String    @default("USER")
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  listings      Listing[]
  sentMessages     Message[]      @relation("SentMessages")
  conversations1   Conversation[] @relation("Buyer")
  conversations2   Conversation[] @relation("Seller")
  reviewsGiven     Review[]       @relation("ReviewAuthor")
  reviewsReceived  Review[]       @relation("ReviewTarget")
  favorites        Favorite[]
  reports          Report[]       @relation("ReportAuthor")
}

model Category {
  id        Int        @id @default(autoincrement())
  nameAr    String
  nameEn    String
  slug      String     @unique
  icon      String?
  parentId  Int?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  listings  Listing[]
}

model Listing {
  id           Int              @id @default(autoincrement())
  title        String
  description  String
  price        Float
  currency     String           @default("SYP") // SYP or USD
  condition    String           @default("GOOD")
  status       String           @default("ACTIVE")
  city         String
  negotiable   Boolean          @default(true)
  viewCount    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sellerId     Int
  seller       User             @relation(fields: [sellerId], references: [id])
  categoryId   Int
  category     Category         @relation(fields: [categoryId], references: [id])

  images       ListingImage[]
  conversations Conversation[]
  favorites    Favorite[]
  reports      Report[]
}

model ListingImage {
  id        Int     @id @default(autoincrement())
  url       String
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         Int       @id @default(autoincrement())
  listingId  Int
  listing    Listing   @relation(fields: [listingId], references: [id])
  buyerId    Int
  buyer      User      @relation("Buyer", fields: [buyerId], references: [id])
  sellerId   Int
  seller     User      @relation("Seller", fields: [sellerId], references: [id])
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       Int
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Review {
  id          Int      @id @default(autoincrement())
  rating      Int      // 1-5
  comment     String?
  authorId    Int
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    Int
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([authorId, targetId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Report {
  id        Int      @id @default(autoincrement())
  reason    String
  authorId  Int
  author    User     @relation("ReportAuthor", fields: [authorId], references: [id])
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())
}
