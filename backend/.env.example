DATABASE_URL="file:./dev.db"
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"
PORT=4000

# Base URL of your web app — used to build the email verification link
APP_URL="http://localhost:5173"

# --- Google Sign-In (optional but recommended) ---
# Get a free Client ID at https://console.cloud.google.com/apis/credentials
# (Create Credentials -> OAuth client ID -> Web application, add
# http://localhost:5173 as an Authorized JavaScript origin)
GOOGLE_CLIENT_ID=""

# --- Apple Sign-In (optional, requires a paid Apple Developer account) ---
APPLE_CLIENT_ID=""

# --- Email (optional) ---
# Leave these empty to test locally: the verification link will simply be
# printed to this terminal instead of emailed. Fill them in with real SMTP
# credentials (e.g. a Gmail App Password, or a service like Resend/SendGrid)
# when you're ready to send real emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
